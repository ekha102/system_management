// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Location {
  loc_id Int @id @default(autoincrement())
  loc_name String
  loc_desc String?
  loc_createdAt DateTime @default(now())
  loc_updatedAt DateTime @updatedAt
  inventories Inventory[] // One Location → Many Inventory
}


model Bin {
  bin_id        Int         @id @default(autoincrement())
  bin_name      String
  bin_desc      String?
  bin_createdAt DateTime    @default(now())
  bin_updatedAt DateTime    @updatedAt

  inventories   Inventory[] // One Bin → Many Inventory
}

enum InventoryStatus {
  Active
  Inactive
}


model Inventory {
  inv_id        Int      @id @default(autoincrement())
  inv_name      String
  inv_desc      String?
  inv_quantity  Int      @default(0)
  inv_status    InventoryStatus @default(Active)
  inv_createdAt DateTime @default(now())
  inv_updatedAt DateTime @updatedAt
  checkedBin   Boolean? @default(false) // 👈 NEW FIELD (safe)
  bin_id Int?
  bin    Bin? @relation(fields: [bin_id], references: [bin_id])
  loc_id Int?
  location Location? @relation(fields: [loc_id], references: [loc_id])
}

