// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "./ERD.svg"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Location {
  loc_id        Int         @id @default(autoincrement())
  loc_name      String
  loc_desc      String?
  loc_createdAt DateTime    @default(now())
  loc_updatedAt DateTime    @updatedAt
  inventories   Inventory[] // One Location → Many Inventory
}

model Bin {
  bin_id        Int      @id @default(autoincrement())
  bin_name      String
  bin_desc      String?
  bin_createdAt DateTime @default(now())
  bin_updatedAt DateTime @updatedAt

  inventories Inventory[] // One Bin → Many Inventory
}

model Store {
  store_id        Int         @id @default(autoincrement())
  store_name      String
  store_desc      String?
  store_createdAt DateTime    @default(now())
  store_updatedAt DateTime    @updatedAt
  inventories     Inventory[] // One Store → Many Inventory
}

model Product {
  prod_id   Int      @id @default(autoincrement())
  prod_name String
  prod_sku  String?  @unique
  prod_desc String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventories Inventory[] // ✅ One Product → Many Inventory records
}

enum InventoryStatus {
  Active
  Inactive
}

enum InventoryAlertLevel {
  Initial
  High
  Medium
  Low
}

model Inventory {
  inv_id Int @id @default(autoincrement())

  // Product Relation (Many inventory rows per product)
  prod_id Int

  inv_quantity  Int                 @default(0)
  inv_restock   Int                 @default(1)
  inv_trigger   Int                 @default(1)
  inv_alerted   InventoryAlertLevel @default(Initial)
  inv_status    InventoryStatus     @default(Active)
  inv_createdAt DateTime            @default(now())
  inv_updatedAt DateTime            @updatedAt
  checkedBin    Boolean?            @default(false)

  bin_id   Int?
  loc_id   Int?
  store_id Int?

  bin      Bin?      @relation(fields: [bin_id], references: [bin_id])
  location Location? @relation(fields: [loc_id], references: [loc_id])
  store    Store?    @relation(fields: [store_id], references: [store_id])
  product  Product   @relation(fields: [prod_id], references: [prod_id])

  transactions InventoryTransaction[]

  @@unique([prod_id, bin_id, loc_id, store_id])
}

enum InvTranType {
  INITIAL //First time setting quantity +
  PURCHASE //You bought more (Costco) +
  CONSUMED //You used/consumed something -
  ADJUST //Fixing a counting mistake +/-
  DISCARD //Expired, broken, thrown away -
}

model InventoryTransaction {
  invtran_id        Int         @id @default(autoincrement())
  inv_id            Int
  invtran_change    Int
  invtran_type      InvTranType @default(INITIAL)
  invtran_note      String?
  invtran_createdAt DateTime    @default(now())

  inventory Inventory @relation(fields: [inv_id], references: [inv_id])
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  user_id       Int    @id @default(autoincrement())
  user_username String @unique
  user_password String
  user_fullName String

  user_status UserStatus @default(ACTIVE)

  user_roleId Int
  role        Role @relation(fields: [user_roleId], references: [role_id])

  user_createdAt DateTime @default(now())
  user_updatedAt DateTime @updatedAt
}

model Role {
  role_id   Int    @id @default(autoincrement())
  role_name String @unique

  permissions RolePermission[]
  users       User[]
}

model Module {
  module_id   Int    @id @default(autoincrement())
  module_name String @unique
  order       Int?

  permissions Permission[]
}

model Action {
  action_id   Int    @id @default(autoincrement())
  action_name String @unique

  permissions Permission[]
}

model Permission {
  perm_id       Int              @id @default(autoincrement())
  perm_moduleId Int
  perm_actionId Int
  module        Module           @relation(fields: [perm_moduleId], references: [module_id])
  action        Action           @relation(fields: [perm_actionId], references: [action_id])
  roles         RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [role_id])
  permission Permission @relation(fields: [permissionId], references: [perm_id])

  @@id([roleId, permissionId])
}
